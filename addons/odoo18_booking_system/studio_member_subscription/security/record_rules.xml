<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="rule_sms_class_category_manager" model="ir.rule">
      <field name="name">Class Category: manager sees all</field>
      <field name="model_id" ref="studio_member_subscription.model_studio_class_category"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups"
             eval="[(4, ref('studio_booking.group_studio_booking_manager'))]"/>
    </record>
    <record id="rule_sms_class_category_user" model="ir.rule">
      <field name="name">Class Category: tenant staff sees assigned tenants only</field>
      <field name="model_id" ref="studio_member_subscription.model_studio_class_category"/>
      <field name="domain_force">[('tenant_id', 'in', user.studio_tenant_ids.ids)]</field>
      <field name="groups"
             eval="[(4, ref('studio_booking.group_studio_booking_user'))]"/>
    </record>
  </data>
</odoo>
