<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form_inherit_studio_booking" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.studio.booking</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app data-string="Studio Booking" string="Studio Booking" name="studio_booking">
          <block title="Member App API" name="studio_booking_member_app_api">
            <setting string="JWT Secret"
                     help="Secret for signing member app tokens. Required for access_token in login response. Leave as-is to keep current value."
                     id="studio_booking_jwt_secret_setting">
              <field name="jwt_secret" password="True"/>
            </setting>
            <setting string="VAPID Private Key"
                     help="Web Push VAPID private key. Must match NEXT_PUBLIC_VAPID_PUBLIC_KEY on frontend. Generate with: npx web-push generate-vapid-keys"
                     id="studio_booking_vapid_private_key_setting">
              <field name="vapid_private_key" password="True"/>
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
