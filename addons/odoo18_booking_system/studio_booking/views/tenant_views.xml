<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_studio_tenant_tree" model="ir.ui.view">
    <field name="name">studio.tenant.list</field>
    <field name="model">studio.tenant</field>
    <field name="arch" type="xml">
      <list string="Tenants" decoration-muted="not active">
        <field name="name"/>
        <field name="code"/>
        <field name="email"/>
        <field name="phone"/>
        <field name="active"/>
      </list>
    </field>
  </record>
  <record id="view_studio_tenant_form" model="ir.ui.view">
    <field name="name">studio.tenant.form</field>
    <field name="model">studio.tenant</field>
    <field name="arch" type="xml">
      <form string="Tenant">
        <sheet>
          <div class="oe_button_box" name="button_box"/>
          <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
          <field name="logo" widget="image" class="oe_avatar" options="{'preview_image': 'logo'}"/>
          <div class="oe_title">
            <h1><field name="name" placeholder="Tenant Name"/></h1>
            <field name="code" placeholder="e.g. my-studio"/>
          </div>
          <group>
            <group string="Contact">
              <field name="email" widget="email"/>
              <field name="phone" widget="phone"/>
              <field name="active"/>
            </group>
            <group string="Email Setup">
              <field name="website_url" widget="url" placeholder="https://example.com"/>
              <field name="login_url" widget="url" placeholder="https://example.com/login"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
