<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_users_form_inherit_studio_tenants" model="ir.ui.view">
    <field name="name">res.users.form.inherit.studio.tenants</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/notebook" position="inside">
        <page string="Studio Access" groups="studio_booking.group_studio_booking_manager">
          <group>
            <field
              name="studio_tenant_ids"
              widget="many2many_tags"
              options="{'no_create': True}"
              string="Assigned Studio Tenants"
            />
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
