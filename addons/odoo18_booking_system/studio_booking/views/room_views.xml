<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_studio_room_tree" model="ir.ui.view">
    <field name="name">studio.room.list</field>
    <field name="model">studio.room</field>
    <field name="arch" type="xml">
      <list string="Rooms" decoration-muted="not active">
        <field name="tenant_id" groups="studio_booking.group_studio_booking_manager"/>
        <field name="branch_id"/>
        <field name="name"/>
        <field name="capacity"/>
        <field name="active"/>
      </list>
    </field>
  </record>
  <record id="view_studio_room_form" model="ir.ui.view">
    <field name="name">studio.room.form</field>
    <field name="model">studio.room</field>
    <field name="arch" type="xml">
      <form string="Room">
        <sheet>
          <group>
            <group>
              <field name="tenant_id" groups="studio_booking.group_studio_booking_manager"/>
              <field name="tenant_id" groups="studio_booking.group_studio_booking_user" invisible="1"/>
              <field name="branch_id" domain="[('tenant_id', '=', tenant_id)]" context="{'default_tenant_id': tenant_id}"/>
              <field name="name"/>
              <field name="capacity"/>
              <field name="active"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
