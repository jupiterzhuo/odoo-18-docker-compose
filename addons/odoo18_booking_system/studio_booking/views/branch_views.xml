<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_studio_branch_tree" model="ir.ui.view">
    <field name="name">studio.branch.list</field>
    <field name="model">studio.branch</field>
    <field name="arch" type="xml">
      <list string="Branches" class="o_studio_branch_list" decoration-muted="not active">
        <field name="tenant_id" groups="studio_booking.group_studio_booking_manager"/>
        <field name="name"/>
        <field name="room_count"/>
        <field name="active"/>
      </list>
    </field>
  </record>
  <record id="view_studio_branch_form" model="ir.ui.view">
    <field name="name">studio.branch.form</field>
    <field name="model">studio.branch</field>
    <field name="arch" type="xml">
      <form string="Branch">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_rooms" type="object" class="oe_stat_button" icon="fa-building-o">
              <field name="room_count" string="Rooms" widget="statinfo"/>
            </button>
          </div>
          <group>
            <group>
              <field name="tenant_id" groups="studio_booking.group_studio_booking_manager"/>
              <field name="name"/>
              <field name="active"/>
            </group>
            <group>
              <field name="room_count"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
