<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sms_class_category_tree" model="ir.ui.view">
    <field name="name">studio.class_category.list</field>
    <field name="model">studio.class_category</field>
    <field name="arch" type="xml">
      <list string="Class Categories" decoration-muted="not active">
        <field name="sequence" widget="handle"/>
        <field name="tenant_id"
               groups="studio_booking.group_studio_booking_manager"/>
        <field name="name"/>
        <field name="template_count"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_sms_class_category_form" model="ir.ui.view">
    <field name="name">studio.class_category.form</field>
    <field name="model">studio.class_category</field>
    <field name="arch" type="xml">
      <form string="Class Category">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_templates" type="object"
                    class="oe_stat_button" icon="fa-book">
              <field name="template_count" string="Templates"
                     widget="statinfo"/>
            </button>
          </div>
          <group>
            <group>
              <field name="tenant_id"
                     groups="studio_booking.group_studio_booking_manager"/>
              <field name="tenant_id" invisible="1"
                     groups="studio_booking.group_studio_booking_user"/>
              <field name="name"/>
              <field name="sequence"/>
              <field name="active"/>
            </group>
          </group>
          <notebook>
            <page string="Class Templates" name="templates">
              <field name="class_template_ids" nolabel="1" readonly="1"
                     context="{'default_tenant_id': tenant_id,
                               'default_category_id': id}">
                <list create="0" delete="0">
                  <field name="name"/>
                  <field name="duration_minutes"/>
                  <field name="active"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_sms_class_category_search" model="ir.ui.view">
    <field name="name">studio.class_category.search</field>
    <field name="model">studio.class_category</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="tenant_id"
               groups="studio_booking.group_studio_booking_manager"/>
        <filter name="active" string="Active"
                domain="[('active', '=', True)]"/>
        <filter name="inactive" string="Archived"
                domain="[('active', '=', False)]"/>
        <group expand="0" string="Group By">
          <filter name="group_tenant" string="Tenant"
                  context="{'group_by': 'tenant_id'}"
                  groups="studio_booking.group_studio_booking_manager"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_sms_class_category" model="ir.actions.act_window">
    <field name="name">Class Categories</field>
    <field name="res_model">studio.class_category</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_active': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create your first class category
      </p>
      <p>
        Group class templates by category (e.g. Backbend, Props, Strength, Stretch).
      </p>
    </field>
  </record>

  <menuitem id="menu_sms_class_category"
    name="Class Categories"
    parent="studio_booking.menu_studio_config"
    action="action_sms_class_category"
    sequence="28"/>
</odoo>
